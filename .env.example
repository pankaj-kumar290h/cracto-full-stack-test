DATABASE_URL=postgresql://release:release@localhost:5433/releases
PORT=4000
# Use the hosted provider's SSL-enabled connection string in production.

# Budget pool connections across all app instances.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
# Optional structured request/query timings (no query variables or note contents).
PERF_LOGGING=false
