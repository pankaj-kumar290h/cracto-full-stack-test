{
  "name": "release-checklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:api": "node --watch --import tsx --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:migrate": "node --import tsx --env-file-if-exists=.env server/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/release.test.ts"
  },
  "dependencies": {
    "express": "4.22.3",
    "graphql": "16.14.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
